if err != nil {
    log.Fatal(err)
}

// Send requests
go func() {
    for i := 0; i < 10; i++ {
        req := &pb.{{.InputType}}{
            // Set fields
        }
        if err := stream.Send(req); err != nil {
            log.Fatal(err)
        }
    }
    stream.CloseSend()
}()

// Receive responses
for {
    resp, err := stream.Recv()
    if err == io.EOF {
        break
    }
    if err != nil {
        log.Fatal(err)
    }
    log.Printf("Response: %v", resp)
}
{{else if .ClientStreaming}}
